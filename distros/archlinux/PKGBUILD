# Maintainer: Damar Narváez Martínez <damar23nnm@gmail.com>
#
# Paquete binario: desempaqueta el AppImage de electron-builder en
# /opt/remotecontrollers (sin FUSE) y expone un launcher en /usr/bin.
#
# Las dependencias de `depends` las instala pacman automáticamente al instalar
# el paquete. Las herramientas específicas del escritorio (kscreen, pipewire,
# hyprland…) se resuelven con `optdepends` o desde el instalador de
# dependencias integrado en la app.

pkgname=remotecontrollers-bin
pkgver=1.0.8
pkgrel=2
pkgdesc="Control remoto seguro de tu PC desde la web o el movil (BJR Software)"
arch=('x86_64')
url="https://remote-controller.bjrsoftware.uk/"
license=('ISC')
provides=('remotecontrollers' 'remote-controller')
conflicts=('remotecontrollers' 'remotecontrollers-git' 'remote-controller')
options=('!debug' '!strip' '!emptydirs')
install=remotecontrollers.install

depends=(
  # Runtime de Electron / Chromium (mismo conjunto que el paquete electron)
  'cairo'
  'dconf'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'harfbuzz'
  'libcups'
  'libdrm'
  'libevent'
  'libgcrypt'
  'libglvnd'
  'libnotify'
  'libpulse'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'libxtst'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  # Herramientas que la app usa en cualquier sesión
  'ddcutil'      # brillo/contraste DDC/CI
  'polkit'       # dialogos de permisos (pkexec)
  'xorg-xrandr'  # modos de pantalla en X11
)

optdepends=(
  'libappindicator-gtk3: icono en la bandeja del sistema (SNI)'
  'pipewire: control de volumen con wpctl (recomendado en Wayland)'
  'kscreen: modos de pantalla en KDE Plasma Wayland'
  'hyprland: modos de pantalla en Hyprland (hyprctl incluido)'
  'wlr-randr: modos de pantalla en Sway/wlroots Wayland'
)

source=(
  "remotecontrollers.AppImage"
  "remotecontrollers.png"
  "remotecontrollers.desktop"
  "remotecontrollers.sh"
  "remotecontrollers.install"
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

prepare() {
  cd "$srcdir"
  chmod +x remotecontrollers.AppImage
  # El modo extract del runtime de AppImage no monta squashfs, así que no
  # necesita FUSE ni en el build ni en el equipo del usuario.
  ./remotecontrollers.AppImage --appimage-extract >/dev/null
  rm -f remotecontrollers.AppImage
}

package() {
  install -d "$pkgdir/opt/remotecontrollers"
  cp -a "$srcdir/squashfs-root/." "$pkgdir/opt/remotecontrollers/"

  install -Dm755 "$srcdir/remotecontrollers.sh" "$pkgdir/usr/bin/remotecontrollers"
  install -Dm644 "$srcdir/remotecontrollers.desktop" "$pkgdir/usr/share/applications/remotecontrollers.desktop"
  install -Dm644 "$srcdir/remotecontrollers.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/remotecontrollers.png"
}
