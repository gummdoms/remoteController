# Lago de datos (releases locales y CI)
DATA_LAKE_URL=https://datalake.dambra-os.com
# Opcional: host SIN proxy de Cloudflare para subir archivos >100 MB
# (subdominio DNS-only, IP de Tailscale o túnel SSH).
# DATA_LAKE_UPLOAD_URL=http://100.x.y.z:3000
DATA_LAKE_USER=tu_usuario
DATA_LAKE_PASSWORD=tu_password
DATA_LAKE_STORAGE_PATH=public/remote-controller
RELEASES_BASE=https://datalake.dambra-os.com/public/remote-controller/releases

# Sesión cloud (opcional: valores por defecto entre paréntesis)
# SESSION_KEEPALIVE_MS=600000        # latido de sesión (10 min)
# SESSION_REFRESH_THRESHOLD_MS=900000  # renovar token si caduca en <15 min
# CLOUD_RECONNECT_MS=5000            # base del backoff del WebSocket
# CLOUD_RECONNECT_MAX_MS=60000       # techo del backoff
# CLOUD_HEARTBEAT_MS=25000           # heartbeat del WebSocket

# GitHub → Settings → Secrets and variables → Actions
#   DATA_LAKE_URL
#   DATA_LAKE_USER
#   DATA_LAKE_PASSWORD
#   TS_AUTHKEY               tailnet auth key (ephemeral) para subir >100 MB
#   DATA_LAKE_UPLOAD_URL     (opcional, host sin Cloudflare; si no, se usa la IP de Tailscale)
#   DATA_LAKE_STORAGE_PATH   (opcional)
#   RELEASES_BASE            (opcional)
